export class TorrentProperties {
  save_path: string = '';
  creation_date: number = 0;
  piece_size: number = 0;
  comment: string = '';
  total_wasted: number = 0;
  total_uploaded: number = 0;
  total_uploaded_session: number = 0;
  total_downloaded: number = 0;
  total_downloaded_session: number = 0;
  up_limit: number = 0;
  dl_limit: number = 0;
  time_elapsed: number = 0;
  seeding_time: number = 0;
  nb_connections: number = 0;
  nb_connections_limit: number = 0;
  share_ratio: number = 0;
  addition_date: number = 0;
  completion_date: number = 0;
  created_by: string = '';
  dl_speed_avg: number = 0;
  dl_speed: number = 0;
  eta: number = 0;
  last_seen: number = 0;
  peers: number = 0;
  peers_total: number = 0;
  pieces_have: number = 0;
  pieces_num: number = 0;
  reannounce: number = 0;
  seeds: number = 0;
  seeds_total: number = 0;
  total_size: number = 0;
  up_speed_avg: number = 0;
  up_speed: number = 0;
  isPrivate: boolean = false;

  static fromJson(json: Record<string, Object>): TorrentProperties {
    const p: TorrentProperties = new TorrentProperties();
    p.save_path = json['save_path'] as string;
    p.creation_date = json['creation_date'] as number;
    p.piece_size = json['piece_size'] as number;
    p.comment = json['comment'] as string;
    p.total_wasted = json['total_wasted'] as number;
    p.total_uploaded = json['total_uploaded'] as number;
    p.total_uploaded_session = json['total_uploaded_session'] as number;
    p.total_downloaded = json['total_downloaded'] as number;
    p.total_downloaded_session = json['total_downloaded_session'] as number;
    p.up_limit = json['up_limit'] as number;
    p.dl_limit = json['dl_limit'] as number;
    p.time_elapsed = json['time_elapsed'] as number;
    p.seeding_time = json['seeding_time'] as number;
    p.nb_connections = json['nb_connections'] as number;
    p.nb_connections_limit = json['nb_connections_limit'] as number;
    p.share_ratio = json['share_ratio'] as number;
    p.addition_date = json['addition_date'] as number;
    p.completion_date = json['completion_date'] as number;
    p.created_by = json['created_by'] as string;
    p.dl_speed_avg = json['dl_speed_avg'] as number;
    p.dl_speed = json['dl_speed'] as number;
    p.eta = json['eta'] as number;
    p.last_seen = json['last_seen'] as number;
    p.peers = json['peers'] as number;
    p.peers_total = json['peers_total'] as number;
    p.pieces_have = json['pieces_have'] as number;
    p.pieces_num = json['pieces_num'] as number;
    p.reannounce = json['reannounce'] as number;
    p.seeds = json['seeds'] as number;
    p.seeds_total = json['seeds_total'] as number;
    p.total_size = json['total_size'] as number;
    p.up_speed_avg = json['up_speed_avg'] as number;
    p.up_speed = json['up_speed'] as number;
    p.isPrivate = json['isPrivate'] as boolean;
    return p;
  }
}
